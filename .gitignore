# ---- 构建产物 --------------------------------------------------------------
/dist/
/target/

# ---- 本地构建配置 ----------------------------------------------------------
# .cargo/config.toml 里的 target-dir 是每台机器自己的路径（本项目开发时指向
# 一块独立的 SSD），提交上去只会干扰别人构建。想改构建目录就自己建这个文件。
/.cargo/config.toml

# ---- 开发过程中的验证产物 ---------------------------------------------------
# 下面这些由 tools/ 下的脚本按需生成，每次跑都会重新产出，不入库：
#   tools/reference_snapshot.js -> reference.html
#   tools/capture.py            -> *.png
#   tools/gui_test.py           -> *.png
#   tools/make_icon.py          -> icon_preview_*.bmp
# docs/ 下的正式配图不受影响（只有根目录的会被忽略）。
/reference.html
/*.png
/*.bmp
/icon_preview_*

# ---- 编辑器 / 工具链缓存 ----------------------------------------------------
.vscode/
.idea/
__pycache__/
*.pyc

# ---- 本机工作记录 -----------------------------------------------------------
/.workbuddy/
